# DocIntel-AI backend configuration.
#
# The app talks to the LLM through OpenRouter (an OpenAI-compatible gateway),
# so you only need to provide two things: an API key and a model id.
#
# 1. Get a key at https://openrouter.ai/keys
# 2. Pick any model from https://openrouter.ai/models (use its "<provider>/<model>" id)
# 3. Copy this file to ".env" in the same folder and fill in the values below.

# Required: your OpenRouter API key.
OPENROUTER_API_KEY=

# The model to use, in OpenRouter's "<provider>/<model>" form.
# Examples: openai/gpt-4o-mini, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Optional tuning (sensible defaults are used if omitted) ---------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DOCINTEL_LLM_TEMPERATURE=0.3
# DOCINTEL_CHUNK_SIZE=800
# DOCINTEL_CHUNK_OVERLAP=100
# DOCINTEL_CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Hybrid retrieval (BM25 + FAISS fused with Reciprocal Rank Fusion) ------
# Both retrievers fetch RETRIEVAL_CANDIDATES_K candidates each; RRF merges the
# two rankings and the top FINAL_CONTEXT_K chunks become the RAG context.
# RRF_K is the fusion damping constant (higher = smaller gap between ranks).
# RETRIEVAL_CANDIDATES_K=20
# FINAL_CONTEXT_K=4
# RRF_K=60

# --- Agentic RAG orchestration (self-healing retrieval) --------------------
# A controlled layer on top of hybrid retrieval and the DEFAULT decider of RAG vs.
# general LLM. It understands the query, judges whether the retrieved evidence can
# actually answer your ORIGINAL question (from the real chunk content, not a
# similarity score), and self-heals by rewriting the query and retrying — bounded —
# before answering or falling back. When enabled, the similarity thresholds in the
# next section become advisory diagnostics (they can no longer decide the route).
# AGENTIC_RAG_ENABLED=true            # master switch; false = legacy one-pass router
# AGENTIC_MAX_RETRIEVAL_ATTEMPTS=3    # hard cap on retrieval attempts per query (>=1; never loops forever)
# AGENTIC_EVIDENCE_THRESHOLD=0.70     # confidence GUIDELINE (0..1) for the evidence judge — NOT a hard score gate

# --- Hybrid routing: RAG vs. general LLM (evidence policy) ------------------
# NOTE: With AGENTIC_RAG_ENABLED=true (the default), these values are ADVISORY
# DIAGNOSTICS fed to the agent's evidence evaluator — they cannot force or block the
# RAG/LLM route on their own. They only decide the route on the legacy
# AGENTIC_RAG_ENABLED=false path. FAISS scoring itself is unchanged; it is simply
# demoted from a hard gate to one signal among several.
#
# RRF (above) decides WHICH chunks are the best context. This separate policy
# decides WHETHER the uploaded document is relevant enough to answer from at all.
# RAG is chosen if ANY of three signals fires; otherwise the question goes to the
# general LLM. All values are optional (defaults shown).
#
# 1) SEMANTIC — a strong FAISS vector match is sufficient on its own. This is the
#    original routing threshold, unchanged in name and default (FAISS relevance,
#    0..1); at/above it => RAG. (Agentic mode: diagnostic signal only.)
# HYBRID_RAG_SIMILARITY_THRESHOLD=0.35
#
# 2) LEXICAL — a genuinely strong keyword match. A chunk BM25-ranked within
#    BM25_STRONG_RANK must actually contain the query's distinctive terms (query
#    words past a stopword list and the MIN_TERM_LEN length floor): at least
#    LEXICAL_MIN_TERMS of them AND at least LEXICAL_MIN_RATIO of all such terms.
#    This lets a strong exact match support RAG even when the vector score is just
#    under the semantic bar, while the ratio/terms guard stops a BM25 rank-1 match
#    on generic words from triggering RAG on its own.
# HYBRID_RAG_BM25_STRONG_RANK=3
# HYBRID_RAG_LEXICAL_MIN_TERMS=1
# HYBRID_RAG_LEXICAL_MIN_RATIO=0.5
# HYBRID_RAG_MIN_TERM_LEN=3
#
# 3) AGREEMENT — cross-retriever corroboration. The SAME chunk appears in the top
#    AGREEMENT_RANK of BOTH BM25 and FAISS, and the vector model still rates it at
#    least FAISS_MODERATE_FLOOR relevance. The floor is the false-positive guard:
#    FAISS always returns nearest neighbours, so agreement without near-relevant
#    semantic support (e.g. a sports question hitting a "2018" chunk in a tax PDF)
#    does NOT count.
# HYBRID_RAG_AGREEMENT_RANK=10
# HYBRID_RAG_FAISS_MODERATE_FLOOR=0.30   # (agentic mode: diagnostic signal only)
